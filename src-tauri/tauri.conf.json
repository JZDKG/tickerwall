{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.tickerwall.desktop",
  "productName": "TickerWall",
  "version": "2.0.0",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://127.0.0.1:8787",
    "beforeDevCommand": "node server.mjs",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TickerWall · 跨资产宏观终端",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      },
      {
        "label": "pip",
        "title": "TickerWall · 盯盘画中画",
        "width": 420,
        "height": 640,
        "minWidth": 320,
        "minHeight": 420,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8787; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "title": "TickerWall"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "可解释的跨资产宏观终端",
    "longDescription": "TickerWall：报价、宏观传导解释、事件流与桌面菜单栏实时行情条。"
  }
}
