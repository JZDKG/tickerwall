.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  display: flex;
  align-items: stretch;
  background: #0b1017;
  border-top: 1rpx solid rgba(255, 255, 255, 0.075);
}

.item {
  position: relative;
  flex: 1;
  height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #5a6474;
}

.label {
  font-size: 20rpx;
  letter-spacing: 0.04em;
}

.item.is-active {
  color: #e8edf5;
}

/* 选中态：顶部一道细线，和 web 导航的下划线是同一个语义 */
.marker {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 3rpx;
  background: #e8edf5;
  transition: width 0.18s ease;
}

.item.is-active .marker {
  width: 44rpx;
}
