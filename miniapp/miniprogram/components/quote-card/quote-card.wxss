.qcard {
  position: relative;
  padding: 22rpx 24rpx 18rpx 30rpx;
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.qcard-hover {
  background: var(--panel-2);
  border-color: var(--line-strong);
}

/* 左侧方向色条：和 web 的 .row::before 一致，3px → 6rpx */
.accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: var(--flat);
  opacity: 0.75;
}

.qcard.up .accent {
  background: var(--up);
}
.qcard.down .accent {
  background: var(--down);
}

.qcard.is-error {
  border-color: rgba(245, 69, 92, 0.35);
}

/* ---------------- 第一行：名称 + 涨跌幅 ---------------- */

.line-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.name-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.market-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  flex: none;
  font-size: 19rpx;
  color: var(--muted-2);
  padding: 2rpx 10rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
}

.market-badge .dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--muted-2);
}

.market-badge .dot.on {
  background: var(--down);
  box-shadow: 0 0 0 4rpx rgba(14, 203, 129, 0.16);
}

/* 涨跌幅药丸 + 涨跌额：右列竖排，和 web 的 .delta 列同构 */
.delta-col {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.pct {
  min-width: 132rpx;
  text-align: right;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  font-family: var(--mono);
  font-size: 26rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  background: rgba(139, 151, 168, 0.12);
  color: var(--flat);
}

.pct.up {
  background: rgba(245, 69, 92, 0.14);
  color: var(--up);
}

.pct.down {
  background: rgba(14, 203, 129, 0.13);
  color: var(--down);
}

.pct.is-fail {
  background: rgba(245, 69, 92, 0.1);
  color: #ff8f9c;
  font-size: 22rpx;
}

/* ---------------- 第二行：副标题 ---------------- */

.line-sub {
  margin-top: 2rpx;
}

.sub {
  font-size: 21rpx;
  color: var(--muted);
}

/* ---------------- 第三行：价格 + 走势 ---------------- */

.line-price {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 6rpx;
}

.price-box {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
}

.value {
  font-family: var(--mono);
  font-size: 50rpx;
  font-weight: 600;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
  color: var(--text);
}

.value.up {
  color: var(--up);
}
.value.down {
  color: var(--down);
}
.value.is-stale-value {
  opacity: 0.45;
}

.unit {
  font-size: 20rpx;
  color: var(--muted-2);
  white-space: nowrap;
}

.spark-box {
  flex: none;
  width: 210rpx;
  height: 62rpx;
  padding-bottom: 4rpx;
}

/* ---------------- 第四行：元信息 ---------------- */

.line-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed rgba(255, 255, 255, 0.055);
  font-family: var(--mono);
  font-size: 20rpx;
  color: var(--muted-2);
  font-variant-numeric: tabular-nums;
}

.meta-text {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sep {
  opacity: 0.5;
}

.fresh {
  color: var(--muted);
}

/* 延迟分级：只有「过期」才值得用警示色，正常不要去打扰用户 */
.fresh.lv-delayed {
  color: #d8a25a;
}

.fresh.lv-stale {
  color: var(--up);
}

.abs {
  font-family: var(--mono);
  font-size: 19rpx;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}

.line-err {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #ff8f9c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------------- 卡内附加报价 ---------------- */

.line-extras {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.extra {
  display: inline-flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  font-size: 20rpx;
  line-height: 1.3;
}

.ex-name {
  color: var(--muted);
}

.ex-val {
  color: var(--text);
  font-weight: 600;
}

.ex-pct.up {
  color: var(--up);
}
.ex-pct.down {
  color: var(--down);
}
.ex-pct.flat {
  color: var(--flat);
}

.qcard.is-stale .value,
.qcard.is-stale .pct {
  opacity: 0.55;
}
