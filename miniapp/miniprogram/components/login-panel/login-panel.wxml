<view class="login">
    <text class="login-title">登录后同步自选</text>
    <text class="login-desc">用邮箱验证码登录。登录后自选会存到云端，换设备也能拉回来；不登录也能正常用，只是自选只留在这台设备。</text>

    <input
        class="login-input"
        type="text"
        placeholder="邮箱"
        placeholder-class="login-placeholder"
        value="{{email}}"
        bindinput="onEmailInput"
    />

    <view class="login-row">
        <input
            class="login-input login-code"
            placeholder="验证码"
            placeholder-class="login-placeholder"
            value="{{code}}"
            bindinput="onCodeInput"
            bindconfirm="submit"
        />
        <view
            class="login-send {{sending || countdown > 0 ? 'login-send-disabled' : ''}}"
            bindtap="sendCode"
        >{{countdown > 0 ? countdown + ' 秒后重发' : (sending ? '发送中' : '获取验证码')}}</view>
    </view>

    <button class="login-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">登录 / 注册</button>

    <text class="login-tip" wx:if="{{tip}}">{{tip}}</text>
    <text class="login-error" wx:if="{{error}}">{{error}}</text>
</view>
