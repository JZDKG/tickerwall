/* ---------------- 导航 ---------------- */

/* 吸顶：滚动时列表会从标题下面穿过去，所以导航必须有实底 + 分割线，
   否则会出现「行情数字压着状态栏时间」的脏画面 */
.nav-fix {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(8, 11, 16, 0.92);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.nav {
  display: flex;
  align-items: center;
  /* 右侧 190rpx 留给微信胶囊按钮，标题不会被压住 */
  padding: 0 190rpx 0 32rpx;
}

.brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.brand-title {
  font-size: 36rpx;
  font-weight: 650;
  letter-spacing: 0.02em;
  color: var(--text);
}

/* 呼吸灯：与 web 顶栏的 .pulse 同一个动效语义（有数据在跳） */
.pulse {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--down);
  animation: pulse 2.4s ease-out infinite;
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(14, 203, 129, 0.45);
  }
  70% {
    box-shadow: 0 0 0 16rpx rgba(14, 203, 129, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(14, 203, 129, 0);
  }
}

/* ---------------- 状态条 ---------------- */

.status-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 4rpx 0 18rpx;
}

.stamp-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.stamp {
  font-size: 21rpx;
  color: var(--muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mode-tag {
  flex: none;
  font-size: 18rpx;
  color: #d8a25a;
  border: 1rpx solid rgba(216, 162, 90, 0.4);
  border-radius: 6rpx;
  padding: 1rpx 8rpx;
}

/* 降级原因：比标签更淡，只占一行，超长省略 */
.mode-why {
  flex: 1;
  min-width: 0;
  font-size: 18rpx;
  color: var(--muted-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.strip-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: none;
}

.ghost-btn {
  font-size: 22rpx;
  color: var(--text);
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  border: 1rpx solid var(--line);
  background: var(--panel-2);
}

.ghost-btn:active {
  background: rgba(255, 255, 255, 0.1);
}

.icon-btn {
  width: 60rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  border: 1rpx solid var(--line);
  background: var(--panel);
}

.icon-btn-hover {
  background: rgba(255, 255, 255, 0.1);
}

/* ---------------- 涨跌分布 ---------------- */

.summary {
  margin-bottom: 20rpx;
}

.sum-nums {
  display: flex;
  align-items: baseline;
  gap: 22rpx;
}

.sum-item {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.sum-num {
  font-family: var(--mono);
  font-size: 30rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.sum-label {
  font-size: 20rpx;
  color: var(--muted-2);
}

.sum-total {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--muted-2);
  font-family: var(--mono);
}

.sum-bar {
  display: flex;
  height: 6rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.06);
}

.seg {
  height: 100%;
}
.seg.up {
  background: var(--up);
}
.seg.down {
  background: var(--down);
}
.seg.flat {
  background: rgba(139, 151, 168, 0.5);
}

/* ---------------- 筛选 ---------------- */

.filters {
  white-space: nowrap;
  margin: 0 -24rpx 18rpx;
}

.filters-inner {
  display: flex;
  gap: 12rpx;
  padding: 0 24rpx;
}

.chip-count {
  font-family: var(--mono);
  font-size: 18rpx;
  color: var(--muted-2);
}

.chip.is-on .chip-count {
  color: var(--text);
  opacity: 0.6;
}

/* ---------------- 列表 ---------------- */

.list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

/* 骨架屏：形态与真卡片一致，替换时不会跳 */
.sk-card {
  padding: 22rpx 24rpx 18rpx 30rpx;
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
}

.sk-line {
  height: 22rpx;
  border-radius: 6rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.05),
    rgba(255, 255, 255, 0.11),
    rgba(255, 255, 255, 0.05)
  );
  background-size: 220% 100%;
  animation: shimmer 1.3s linear infinite;
}

.sk-line.tall {
  height: 46rpx;
}

.sk-line.w40 {
  width: 40%;
}
.sk-line.w55 {
  width: 55%;
}
.sk-line.w70 {
  width: 70%;
}

@keyframes shimmer {
  from {
    background-position: 140% 0;
  }
  to {
    background-position: -40% 0;
  }
}

/* ---------------- 错误 / 页脚 ---------------- */

.err-box {
  padding: 60rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.err-detail {
  font-size: 20rpx;
  color: var(--muted-2);
  text-align: center;
  padding: 0 40rpx;
}

.retry {
  margin-top: 8rpx;
  padding: 12rpx 40rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--line-strong);
  background: var(--panel-2);
  font-size: 24rpx;
  color: var(--text);
}

.foot {
  margin-top: 32rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 19rpx;
  color: var(--muted-2);
}

.foot-note {
  color: rgba(90, 100, 116, 0.9);
  line-height: 1.5;
}
