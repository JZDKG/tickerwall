/* ---------------- 页头 ---------------- */

.head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0 8rpx;
}

.head-title {
  display: block;
  font-size: 40rpx;
  font-weight: 650;
  letter-spacing: 0.02em;
}

.head-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.head-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.stamp {
  font-size: 19rpx;
  color: var(--muted-2);
}

.mode-tag {
  font-size: 18rpx;
  color: #d8a25a;
  border: 1rpx solid rgba(216, 162, 90, 0.4);
  border-radius: 6rpx;
  padding: 1rpx 8rpx;
}

/* ---------------- 重要度标记 ---------------- */

.lvl {
  flex: none;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  border: 1rpx solid transparent;
}

.lvl.lv-high {
  color: var(--up);
  border-color: rgba(245, 69, 92, 0.4);
  background: rgba(245, 69, 92, 0.1);
}

.lvl.lv-mid {
  color: #d8a25a;
  border-color: rgba(216, 162, 90, 0.36);
  background: rgba(216, 162, 90, 0.08);
}

.lvl.lv-low {
  color: var(--muted);
  border-color: var(--line);
  background: rgba(255, 255, 255, 0.03);
}

.topic {
  font-size: 18rpx;
  color: var(--muted);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

/* ---------------- 今日重点 ---------------- */

.focus-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.focus-card {
  position: relative;
  padding: 20rpx 22rpx 18rpx 26rpx;
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
}

.focus-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 5rpx;
  border-radius: 0 4rpx 4rpx 0;
  background: var(--muted-2);
}

.focus-card.lv-high::before {
  background: var(--up);
}

.focus-card.lv-mid::before {
  background: #d8a25a;
}

.focus-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.focus-time {
  font-size: 21rpx;
  color: var(--muted);
}

.focus-src {
  margin-left: auto;
  font-size: 19rpx;
  color: var(--muted-2);
}

.focus-title {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 600;
  color: var(--text);
}

.focus-topics {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
}

/* ---------------- 筛选 ---------------- */

.filters {
  display: flex;
  gap: 12rpx;
  margin: 26rpx 0 8rpx;
}

.chip-count {
  font-family: var(--mono);
  font-size: 18rpx;
  color: var(--muted-2);
}

.chip.is-on .chip-count {
  color: var(--text);
  opacity: 0.6;
}

/* ---------------- 事件流 ---------------- */

.stream {
  margin-top: 8rpx;
}

.ev {
  display: flex;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.ev:last-child {
  border-bottom: none;
}

.ev-side {
  position: relative;
  flex: none;
  width: 84rpx;
  padding-top: 2rpx;
}

.ev-time {
  display: block;
  font-size: 24rpx;
  color: var(--text);
  font-weight: 600;
}

.ev-date {
  display: block;
  margin-top: 2rpx;
  font-size: 17rpx;
  color: var(--muted-2);
}

/* 时间轴：一条竖线 + 一个点，点的颜色就是重要度 */
.ev-dot {
  position: absolute;
  right: -9rpx;
  top: 10rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--muted-2);
}

.ev-dot.lv-high {
  background: var(--up);
  box-shadow: 0 0 0 6rpx rgba(245, 69, 92, 0.12);
}

.ev-dot.lv-mid {
  background: #d8a25a;
  box-shadow: 0 0 0 6rpx rgba(216, 162, 90, 0.1);
}

.ev-main {
  flex: 1;
  min-width: 0;
  padding-left: 14rpx;
  border-left: 1rpx solid rgba(255, 255, 255, 0.06);
}

.ev-tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ev-src {
  font-size: 19rpx;
  color: var(--muted-2);
}

.ev-title {
  display: block;
  margin-top: 8rpx;
  font-size: 27rpx;
  line-height: 1.5;
  color: var(--text);
}

.ev-body {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--muted);
}

.ev-body.is-open {
  -webkit-line-clamp: 20;
}

.ev-foot {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.ev-topics {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.ev-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-left: auto;
  font-size: 20rpx;
  color: var(--accent);
}

/* ---------------- 骨架 / 错误 / 页脚 ---------------- */

.sk-list {
  padding-top: 20rpx;
}

.sk-row {
  display: flex;
  gap: 20rpx;
  padding: 22rpx 0;
}

.sk-time {
  width: 84rpx;
  height: 22rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
  background-size: 220% 100%;
  animation: shimmer 1.3s linear infinite;
}

.sk-body {
  flex: 1;
}

.sk-line {
  height: 22rpx;
  border-radius: 6rpx;
  margin-bottom: 12rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
  background-size: 220% 100%;
  animation: shimmer 1.3s linear infinite;
}

.sk-line.w80 {
  width: 80%;
}
.sk-line.w55 {
  width: 55%;
}

@keyframes shimmer {
  from {
    background-position: 140% 0;
  }
  to {
    background-position: -40% 0;
  }
}

.err-box {
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.err-detail {
  font-size: 20rpx;
  color: var(--muted-2);
  text-align: center;
  padding: 0 40rpx;
}

.retry {
  padding: 12rpx 40rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--line-strong);
  background: var(--panel-2);
  font-size: 24rpx;
  color: var(--text);
}

.foot {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 19rpx;
  color: var(--muted-2);
  line-height: 1.5;
}

.foot-note {
  color: rgba(90, 100, 116, 0.9);
}

/* ---------------- AI 摘要 ----------------
   底色比事件卡更淡、左侧一条细高亮：它是「另一类东西」，
   不该和人工核对过的行情/快讯长得一样。 */

.ai-card {
  margin: 16rpx 0 6rpx;
  padding: 20rpx 20rpx 16rpx;
  border: 1rpx solid rgba(110, 168, 254, 0.22);
  border-left: 3rpx solid rgba(110, 168, 254, 0.7);
  border-radius: 12rpx;
  background: rgba(110, 168, 254, 0.05);
}

.ai-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.ai-badge {
  font-size: 19rpx;
  letter-spacing: 0.08em;
  color: #9cc4ff;
  border: 1rpx solid rgba(110, 168, 254, 0.45);
  border-radius: 6rpx;
  padding: 1rpx 8rpx;
}

.ai-hint {
  font-size: 19rpx;
  color: var(--muted-2);
}

.ai-hint.err {
  color: #d8a25a;
}

.ai-regen {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--muted);
  padding: 2rpx 10rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
}

.ai-text {
  display: block;
  font-size: 25rpx;
  line-height: 1.75;
  color: var(--text);
}

.ai-ph {
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--muted-2);
}

.ai-foot {
  margin-top: 12rpx;
  font-size: 18rpx;
  color: var(--muted-2);
}

.ai-retry {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #9cc4ff;
  align-self: flex-start;
}

/* ---------------- 外文翻译 ----------------
   一条窄条，不抢摘要卡的位置：它只是「列表里混进了外文」的提示 + 一个按钮。 */

.tr-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 10rpx 0 6rpx;
  padding: 12rpx 16rpx;
  border: 1rpx dashed rgba(255, 255, 255, 0.12);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.02);
}

.tr-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tr-badge {
  font-size: 18rpx;
  letter-spacing: 0.06em;
  color: var(--muted);
  border: 1rpx solid var(--line);
  border-radius: 6rpx;
  padding: 1rpx 8rpx;
}

.tr-hint {
  font-size: 21rpx;
  color: var(--muted);
}

.tr-btn {
  margin-left: auto;
  flex: none;
  font-size: 21rpx;
  color: #9cc4ff;
  padding: 4rpx 16rpx;
  border: 1rpx solid rgba(110, 168, 254, 0.4);
  border-radius: 8rpx;
  background: rgba(110, 168, 254, 0.08);
}

.tr-btn.is-busy {
  color: var(--muted-2);
  border-color: var(--line);
  background: transparent;
}

.tr-err {
  margin: -2rpx 0 8rpx 4rpx;
  font-size: 19rpx;
  color: #d8a25a;
}

/* 卡片上的「AI 译」角标 + 被替换的原文 */
.tr-tag {
  font-size: 17rpx;
  color: #9cc4ff;
  border: 1rpx solid rgba(110, 168, 254, 0.35);
  border-radius: 5rpx;
  padding: 0 6rpx;
  line-height: 1.5;
}

.ev-orig {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--muted-2);
}
