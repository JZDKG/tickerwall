{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tickerwall.local/contracts/observation.schema.json",
  "title": "Observation",
  "description": "一条标准观测。来源适配器解析出的每个数值都必须长成这样，业务层才接受。时间有三个，含义不同：observedAt 是市场观测时间，publishedAt 是发布者公布时间（可为空），fetchedAt/knownAt 是系统抓取与「当时可知」的时间。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instrumentId",
    "observedAt",
    "value",
    "unit",
    "valueDomain",
    "sourceRef"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "logicalKey": {
      "type": "string",
      "minLength": 1
    },
    "instrumentId": {
      "type": "string",
      "minLength": 1
    },
    "observedAt": {
      "type": "string",
      "format": "date"
    },
    "publishedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "fetchedAt": {
      "type": "string",
      "format": "date-time"
    },
    "knownAt": {
      "type": "string",
      "format": "date-time"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "valueDomain": {
      "enum": [
        "positive",
        "signed"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "quality": {
      "type": [
        "object",
        "null"
      ]
    },
    "sourceRef": {
      "description": "来源标识；允许 null 表示「来源未知」。不允许空字符串（那是「没填」）。",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "examples": [
    {
      "id": "gold-intl@2026-10-20",
      "logicalKey": "gold-intl",
      "instrumentId": "gold-intl",
      "observedAt": "2026-10-20",
      "publishedAt": null,
      "fetchedAt": "2026-10-28T11:00:00.000Z",
      "knownAt": "2026-10-28T11:00:00.000Z",
      "value": 4123.45,
      "unit": "美元/盎司",
      "valueDomain": "positive",
      "revision": 1,
      "sourceRef": "fred:DEXUSAL"
    }
  ]
}
