# TickerWall 环境变量模板
# 用法：cp .env.example .env，按需要填值；容器里用 -e / --env-file 注入。
# 安全：.env 别入库；本文件只放变量名与说明，不放任何真实凭据。

# ---- 服务 ----
PORT=8787
# 容器里要监听所有网卡；本机直跑默认 127.0.0.1
HOST=127.0.0.1
# 数据卷：SQLite、事件归档、快照都落在这里（Docker 挂 /app/data）
KANBAN_DATA_DIR=./data

# ---- 官方数据源 API Key（Phase 1 FRED / BLS v2 适配器接入；Phase 0 先占位）----
FRED_API_KEY=
BLS_API_KEY=

# ---- LLM 复核（快讯语义分类）----
# 三个都配上才会启用；留空时优雅跳过 LLM 调用（不报错、不重试、不显示徽章）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 本地开发便利开关：只有显式设为 1 才回落到本机 magpie 网关
# （http://127.0.0.1:3425/v1）。容器/生产默认绝不盲打这个端口。
LLM_ALLOW_LOCAL_DEFAULT=0
# 只有显式设为 dsh 才读取 ~/.dsh 的私有 YAML 与凭据；默认链路零宿主文件访问。
LLM_CONFIG_SOURCE=env
