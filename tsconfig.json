{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*.js", "src/**/*.ts", "src/**/*.tsx", "vite.config.js", "tools/**/*.mjs"],
  "exclude": ["node_modules", "public/vendor/**", "src/client/vendor/geo-kit.js"]
}
